{
  "sections": {
    "main": {
      "type": "custom-product",
      "blocks": {
        "title": {
          "type": "title",
          "settings": {}
        },
        "rating": {
          "type": "rating",
          "settings": {}
        },
        "product_grouping_picker_1": {
          "type": "product_grouping_picker",
          "settings": {
            "heading": "Product Grouping Picker",
            "picker_type": "button",
            "grouping_label": "VZ-Größen-Nr.",
            "option_type_metafield_key": "product_grouping_option_1",
            "option_value_metafield_key": "product_grouping_option_1_value"
          }
        },
        "product_grouping_picker_2": {
          "type": "product_grouping_picker",
          "settings": {
            "heading": "Product Grouping Picker",
            "picker_type": "button",
            "grouping_label": "VZ-Seitenlänge",
            "option_type_metafield_key": "product_grouping_option_2",
            "option_value_metafield_key": "product_grouping_option_2_value"
          }
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "sku": {
          "type": "sku",
          "settings": {
            "text_style": "subtitle"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "custom_options": {
          "type": "custom_options",
          "settings": {
            "product_options_box_label": "OPTIONEN",
            "product_options_label": "Lochung von Verkehrszeichen",
            "checkbox_option_label": "QR-Code Etikett",
            "checkbox_option_price": 275
          }
        },
        "custom_summary": {
          "type": "custom_summary",
          "settings": {
            "summary_title": "ZUSAMMENFASSUNG",
            "enable_summary": true,
            "enable_qr_code_summary": true
          }
        },
        "quantity_and_buy_buttons": {
          "type": "quantity_and_buy_buttons",
          "settings": {
            "show_quantity_selector": true,
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": true
          }
        },
        "popup": {
          "type": "popup",
          "settings": {
            "text": "Angebotsanfrage",
            "page": ""
          }
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "text_style": "body",
            "inventory_threshold": 10,
            "show_inventory_quantity": false
          }
        },
        "icon_with_text": {
          "type": "icon-with-text",
          "settings": {
            "layout": "vertical",
            "icon_1": "truck",
            "heading_1": "Versandkostenfrei ab 1.500€",
            "icon_2": "plane",
            "heading_2": "Geprüftes Sortiment",
            "icon_3": "stopwatch",
            "heading_3": "Einfache Abwicklung"
          }
        }
      },
      "block_order": [
        "title",
        "rating",
        "variant_picker",
        "product_grouping_picker_1",
        "product_grouping_picker_2",
        "price",
        "sku",
        "custom_options",
        "custom_summary",
        "quantity_and_buy_buttons",
        "popup",
        "inventory",
        "icon_with_text"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "gallery_layout": "thumbnail_slider",
        "media_position": "left",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "show_rating": true,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "collapsible_content_custom": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_description": {
          "type": "collapsible_row",
          "settings": {
            "heading": "description",
            "icon": "none",
            "row_content": "{{ product.description }}",
            "page": ""
          }
        },
        "collapsible_row_characteristics": {
          "type": "collapsible_row",
          "settings": {
            "heading": "characteristics",
            "icon": "none",
            "row_content": "{{ product.metafields.custom.characteristics | metafield_tag }}",
            "page": ""
          }
        },
        "collapsible_row_reviews": {
          "type": "collapsible_row",
          "settings": {
            "heading": "reviews",
            "icon": "none",
            "row_content": "",
            "page": ""
          }
        }
      },
      "block_order": ["collapsible_row_description", "collapsible_row_characteristics", "collapsible_row_reviews"],
      "settings": {
        "custom_class": "custom-product-collapsible",
        "caption": "",
        "heading": "",
        "heading_size": "h1",
        "heading_alignment": "center",
        "layout": "section",
        "color_scheme": "",
        "container_color_scheme": "scheme-1",
        "open_first_collapsible_row": true,
        "image_ratio": "adapt",
        "desktop_layout": "image_second",
        "padding_top": 24,
        "padding_bottom": 24,
        "show_reviews": true
      }
    },
    "product_tabs_slider_1": {
      "type": "product-tabs-slider",
      "settings": {
        "custom_class": "hide-on-mobile",
        "tab1_title": "ZUBEHÖR",
        "collection_1": "all",
        "tab2_title": "ZUBEHÖR & ERSATZTEILE",
        "collection_2": "automated-collection",
        "products_to_show": 12
      }
    },
    "product_tabs_slider_2": {
      "type": "product-tabs-slider",
      "settings": {
        "custom_class": "hide-on-mobile",
        "tab1_title": "KUNDEN KAUFTEN AUCH",
        "collection_1": "automated-collection",
        "tab2_title": "ZULETZT GESEHEN",
        "collection_2": "all",
        "products_to_show": 12
      }
    },
    "product_slider_accesories": {
      "type": "product-slider",
      "settings": {
        "custom_class": "hide-on-dekstop",
        "title": "ZUBEHÖR",
        "collection": "automated-collection",
        "products_to_show": 8,
        "show_rating": true
      }
    },
    "product_slider_related-products": {
      "type": "product-slider",
      "settings": {
        "custom_class": "hide-on-dekstop",
        "title": "KUNDEN KAUFTEN AUCH",
        "collection": "automated-collection",
        "products_to_show": 8,
        "show_rating": true
      }
    }
  },
  "order": [
    "main",
    "collapsible_content_custom",
    "product_tabs_slider_1",
    "product_tabs_slider_2",
    "product_slider_accesories",
    "product_slider_related-products"
  ]
}
